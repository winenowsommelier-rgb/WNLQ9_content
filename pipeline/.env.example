# --- Notion (required) ---
# Notion integration token. Share the integration with the
# "2026 JUN - WNLQ9 - Content Production" database.
NOTION_TOKEN=
# Optional: override the target database (defaults to the June 2026 production DB).
# NOTION_DATABASE_ID=786d080f-8da2-4a1e-b84e-161f4e19d56d

# --- Dashboard API auth (required for the web dashboard) ---
# Shared passphrase callers must send as the X-Ingest-Secret header.
# The API fails closed when this is unset.
INGEST_SECRET=

# --- Draft generation (required for /api/generate) ---
ANTHROPIC_API_KEY=
# Optional model override.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Drive (required for /api/approve) ---
# Service-account JSON as a single-line string: {"client_email":"...","private_key":"..."}
# Share the destination Drive folder with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=

# --- Supabase (required for /api/sync-plan and /api/plan) ---
# Project: "WNLQ9 PI DB" (holds products, content_plan, pick_products()).
SUPABASE_URL=https://dsyplzckfezcxiuikkfm.supabase.co
# Service-role key (Supabase Dashboard -> Settings -> API). Server-side only —
# it bypasses RLS, so never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel Cron (required to authorize the scheduled /api/sync-plan) ---
# Any long random string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
# to cron invocations; /api/sync-plan also accepts INGEST_SECRET for manual runs.
CRON_SECRET=

# --- GA4 + GSC for content planning ---
# Two ways in (both feed pipeline/scripts/plan-from-csv.mjs); see docs/GA_GSC_PLANNING.md
#  A) AUTOMATED (preferred): pipeline/scripts/ga-gsc-pull.mjs pulls the FREE GA4 +
#     GSC APIs and writes pipeline/data/{ga4,gsc}.csv. Needs the vars below in the
#     RUN environment. Service account (stable for unattended pulls). Read-only.
#  B) MANUAL fallback (no creds): drop pipeline/data/ga4.csv + gsc.csv by hand.
# Service account JSON — reuses GOOGLE_SERVICE_ACCOUNT_JSON above unless set here:
# GA_GSC_SERVICE_ACCOUNT_JSON=
# GA4 numeric property IDs (GA4 Admin → Property Settings → Property ID)
GA4_PROPERTY_WN=
GA4_PROPERTY_LIQ9=
# GSC property exactly as registered: "sc-domain:wine-now.com" OR "https://th.wine-now.com/"
GSC_SITE_WN=
GSC_SITE_LIQ9=
