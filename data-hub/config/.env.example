# Content Trend Data Hub — environment template
#
# Copy to `.env` (NEVER commit the real .env — it is gitignored) and fill in
# real values, or set these directly in your shell / scheduler environment.
#
# The hub runs fine with NO env at all: it defaults to a local SQLite
# system-of-record at data/content_hub.db. The variables below are optional.

# --- Google Sheets mirror (optional) ---------------------------------------
# Target Google Sheet id for the read-only dashboard mirror.
# DATA_HUB_SHEET_ID=

# --- Storage backend selection (optional) ----------------------------------
# Pick the ArticleStore backend. Unset (or anything other than "supabase")
# keeps the default local SQLite store. Set to "supabase" AND provide the two
# creds below to use the managed Postgres (Supabase) backend instead — it is a
# drop-in (identical ArticleStore interface and return shapes).
# DATA_HUB_DB_BACKEND=supabase

# Supabase project (WNLQ9 SEO Automation). The tables content_hub_articles /
# content_hub_runs already exist there (created via migration).
# SUPABASE_URL=https://asnarjokyedupsjipzkl.supabase.co

# The SERVICE-ROLE secret (Supabase dashboard → Settings → API → service_role).
# This key bypasses RLS — treat it as a secret, never commit it.
# SUPABASE_SERVICE_KEY=<service_role secret>
