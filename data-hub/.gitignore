venv/
__pycache__/
*.pyc
.pytest_cache/

# Google service-account credentials (secret -- never commit)
config/google-credentials.json

# Environment files with secrets (Supabase service_role key, etc.) -- never
# commit. The committed template is config/.env.example.
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example

# Runtime logs (keep the directory via logs/.gitkeep, ignore log files)
logs/*
!logs/.gitkeep

# SQLite system-of-record DB + its WAL/SHM sidecar files (keep the dir via
# data/.gitkeep, never commit the data itself).
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Local enrichment intermediate files
data/enrich/
