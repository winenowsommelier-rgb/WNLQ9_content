# WNLQ9 content operation — required & optional credentials.
# Copy to .env.local (gitignored) for local CLI use, OR add as secrets in your
# Claude Code web environment / GitHub Actions. NEVER commit real values.
# Full instructions: docs/wnlq9/08-SECRETS-AND-ACCESS.md

# ---- REQUIRED: the content lives in Notion ----
# Internal integration token from https://www.notion.so/my-integrations
# Then share the "2026 Content Calendar Hub" page with that integration.
NOTION_TOKEN=

# ---- REQUIRED only if running Claude Code via GitHub Action / CLI headless ----
ANTHROPIC_API_KEY=

# ---- BI & Product Engine (live sales/customer/product/forecast data, THB) ----
# REST API at https://wnlq9-bi-api.vercel.app  (sent as header X-API-Key).
# Also requires the runtime to allow egress to wnlq9-bi-api.vercel.app.
# See docs/wnlq9/09-BI-PRODUCT-ENGINE.md
WNLQ9_API_KEY=

# ---- OPTIONAL: live SEO / keyword data (DataForSEO) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- OPTIONAL: analytics for data-driven refreshes (GA4 / Search Console) ----
# Path to / contents of a Google service-account JSON, plus property/site IDs.
GA4_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- OPTIONAL: existing app stack (already used by the Next.js dashboard) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SLACK_BOT_TOKEN=
